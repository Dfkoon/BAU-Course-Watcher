# ==========================================
# إعدادات نظام مراقبة جريدة المواد - BAU
# ==========================================

# إعدادات الإيميل SMTP (fallback فقط)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# مفاتيح API عبر HTTPS (مفضلة على Render)
BREVO_API_KEY=your_brevo_api_key
RESEND_API_KEY=your_resend_api_key
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_BASE_URL=https://your-domain.api.infobip.com
INFOBIP_SENDER=your_verified_sender@example.com
EMAIL_SENDER=your_verified_sender@example.com

# اسم المرسل في الإشعارات
SENDER_NAME=مكانك لمراقبة جريدة المواد - جامعة البلقاء

# مفتاح تشفير جلسات Flask
FLASK_SECRET=your_flask_secret_here

# كلمة مرور وتوليد حساب الادمن الأول
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# فترة الفحص بالثواني (الحد الأدنى 30 ثانية لعدم الضغط على سيرفر الجامعة)
CHECK_INTERVAL_SECONDS=45

# البورت للسيرفر المحلي
PORT=5050

# رابط السيرفر الخارجي على Render (ضروري لنظام KeepAlive لمنع النوم)
# على Render: اكتب رابط السيرفر كاملاً مثل https://bau-course-watcher.onrender.com
RENDER_EXTERNAL_URL=https://your-service.onrender.com

