# ==========================================
# إعدادات نظام مراقبة جريدة المواد - BAU
# ==========================================

# إعدادات الإيميل SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# اسم المرسل في الإشعارات
SENDER_NAME=مكانك لمراقبة جريدة المواد - جامعة البلقاء

# مفتاح تشفير جلسات Flask
FLASK_SECRET=your_flask_secret_here

# كلمة مرور وتوليد حساب الادمن الأول
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# فترة الفحص بالثواني (الحد الأدنى 30 ثانية لعدم الضغط على سيرفر الجامعة)
CHECK_INTERVAL_SECONDS=45

# البورت للسيرفر المحلي
PORT=5050
